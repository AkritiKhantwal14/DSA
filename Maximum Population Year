class Solution {
    public int maximumPopulation(int[][] logs) {
        int year[]=new int[101];
        for(int i=0; i<logs.length; i++){
            int birth=logs[i][0];
            int death= logs[i][1];
            for(int j= birth; j<death; j++){
                year[j-1950]++;
            }

        }
        int max=0;
        int ans=1950;
        for(int i=0; i<101; i++){
            if(year[i]>max){
                max=year[i];
                ans=i+1950;
            }
        }
        return ans;
        
    }
}
