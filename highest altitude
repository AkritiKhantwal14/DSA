class Solution {
    public int largestAltitude(int[] gain) {
        int alt[]= new int[gain.length+1];
        int sum=0;
        alt[0]=0;
        for(int i=0; i<gain.length; i++){
            sum=sum+gain[i];
            alt[i+1]=sum;
        }
        int max=alt[0];
       for(int i=0; i< gain.length+1; i++){
            if(alt[i]> max){
                max=alt[i];
            }
       }
       return max;
    }
}
